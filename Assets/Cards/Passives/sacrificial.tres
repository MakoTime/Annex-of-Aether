[gd_resource type="Resource" script_class="PassiveData" load_steps=15 format=3]

[ext_resource type="Script" path="res://Scripts/Cards/Passives/passive_data.gd" id="1_passive"]
[ext_resource type="Script" path="res://Scripts/Cards/Passives/passive_action_data.gd" id="2_action"]
[ext_resource type="Script" path="res://Scripts/Cards/target.gd" id="3_target"]
[ext_resource type="Script" path="res://Scripts/Cards/effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://Scripts/Cards/trigger.gd" id="5_trigger"]
[ext_resource type="Script" path="res://Scripts/Cards/condition.gd" id="6_condition"]

[sub_resource type="Resource" id="Resource_event_target"]
script = ExtResource("3_target")
id = &"event_target"
text = "the affected unit"

[sub_resource type="Resource" id="Resource_swap_effect"]
script = ExtResource("4_effect")
id = &"swap"
text = "swap places with {target}"

[sub_resource type="Resource" id="Resource_redirect_effect"]
script = ExtResource("4_effect")
id = &"redirect_damage"
text = "take the damage instead of {target}"

[sub_resource type="Resource" id="Resource_before_damage"]
script = ExtResource("5_trigger")
id = &"before_attack_damage"
text = "Before an attack deals damage"

[sub_resource type="Resource" id="Resource_allied_hero"]
script = ExtResource("6_condition")
id = &"event_target_is_adjacent_allied_hero"
text = "the affected unit is an adjacent allied hero"

[sub_resource type="Resource" id="Resource_can_swap"]
script = ExtResource("6_condition")
id = &"can_swap_with_event_target"
text = "this unit can swap with the affected unit"

[sub_resource type="Resource" id="Resource_swap"]
script = ExtResource("2_action")
id = &"swap"
effect = SubResource("Resource_swap_effect")
target = SubResource("Resource_event_target")

[sub_resource type="Resource" id="Resource_redirect"]
script = ExtResource("2_action")
id = &"redirect_damage"
effect = SubResource("Resource_redirect_effect")
target = SubResource("Resource_event_target")

[resource]
script = ExtResource("1_passive")
id = &"sacrificial"
keyword = &"sacrificial"
display_name = "Sacrificial"
trigger = SubResource("Resource_before_damage")
conditions = Array[ExtResource("6_condition")]([SubResource("Resource_allied_hero"), SubResource("Resource_can_swap")])
actions = Array[ExtResource("2_action")]([SubResource("Resource_swap"), SubResource("Resource_redirect")])